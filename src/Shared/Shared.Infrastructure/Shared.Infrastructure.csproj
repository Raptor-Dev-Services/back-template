<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infraestructura compartida: el DbContext unico, sus migraciones y (mas adelante) las piezas
    transversales que necesitan un SDK. NO referencia a ningun modulo: cada modulo le publica sus
    configuraciones de EF (ModuleModel).
  -->
  <ItemGroup>
    <ProjectReference Include="$(CommonRoot)Common.MultiTenancy/Common.MultiTenancy.csproj" />
    <ProjectReference Include="../Shared.Kernel/Shared.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
