{
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "back-template",
    "Audience": "back-template-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },

  "Auth": {
    "InvitationHours": 72,
    "PasswordResetMinutes": 60
  },

  "Totp": {
    "Issuer": "back-template",
    "RecoveryCodeCount": 10,
    "ChallengeMinutes": 5
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ForwardedHeaders": {
    "Enabled": false
  },

  "RateLimiting": {
    "AuthPerMinute": 10,
    "UploadPerMinute": 30,
    "GlobalPerMinute": 300
  },

  "CustomLogging": {
    "Project": "back-template",
    "Application": "back-template-api",
    "Version": "0.0.0",
    "SeqUri": "",
    "LogEventLevel": "Information",
    "IncludeSqlText": false
  },

  "Observability": {
    "ServiceName": "back-template-api",
    "ServiceVersion": "0.0.0",
    "MeterName": "BackTemplate.Api",
    "OtlpEndpoint": ""
  },

  "Swagger": {
    "Enabled": false,
    "Title": "back-template API"
  }
}
