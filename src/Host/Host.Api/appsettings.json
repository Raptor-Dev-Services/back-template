{
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "back-template",
    "Audience": "back-template-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },

  "Auth": {
    "InvitationHours": 72,
    "PasswordResetMinutes": 60
  },

  "Totp": {
    "Issuer": "back-template",
    "RecoveryCodeCount": 10,
    "ChallengeMinutes": 5
  },

  "BackgroundJobs": {
    "DispatcherEnabled": true,
    "PollSeconds": 60,
    "OperatorTenantId": null,
    "SessionPurge": {
      "DryRun": true,
      "RetentionDays": 30
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ForwardedHeaders": {
    "Enabled": false
  },

  "RateLimiting": {
    "AuthPerMinute": 10,
    "UploadPerMinute": 30,
    "GlobalPerMinute": 300
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "Seq": {
    "ServerUrl": ""
  },

  "Observability": {
    "ServiceName": "back-template-api",
    "ServiceVersion": "0.0.0",
    "MeterName": "BackTemplate.Api",
    "OtlpEndpoint": ""
  },

  "Swagger": {
    "Enabled": false,
    "Title": "back-template API"
  }
}
