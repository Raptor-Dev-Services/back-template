# =============================================================================
# back-template - variables de entorno. Copia a .env (NO versionado): cp .env.example .env
# =============================================================================
# La API carga .env SOLO en Development y SIN pisar variables ya definidas: una variable de
# entorno real siempre gana. En cualquier otro entorno la configuracion llega por el entorno
# del proceso (el pipeline de deploy la inyecta); nunca por un .env dentro de la imagen.
#
# POR QUE ALGUNAS VIENEN RELLENAS Y OTRAS NO. En un archivo versionado va el NOMBRE de la
# variable, nunca un secreto. La unica excepcion son las credenciales del STACK DE DESARROLLO
# LOCAL (devstack): abren un Postgres, un Redis y un buzon que solo escuchan en tu maquina y no
# tienen datos de nadie. Estan para que copiar este archivo deje el entorno funcionando.
#
# Las llaves de firma y de cifrado van VACIAS a proposito. Generalas tu (openssl rand -base64 48)
# y no las reutilices en ningun otro entorno: con Jwt__Key cualquiera fabrica un token de
# administrador de cualquier tenant.
#
# Ante la duda: si publicar el valor en internet causa algun dano, va vacio.
# =============================================================================

# --- ASP.NET -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
# 5060 en los dos modos (dotnet run y contenedor). Mapa de puertos de la maquina: devstack/PUERTOS.md.
ASPNETCORE_URLS=http://localhost:5060

# --- PostgreSQL (devstack) ---------------------------------------------------
# La APP se conecta con el rol backtemplate_app: solo DML, sin superusuario y SIN BYPASSRLS. Con
# un rol privilegiado las policies de RLS se ignoran sin ningun sintoma, y por eso la API se
# niega a arrancar si detecta uno (RlsRoleGuard). Roles y base: scripts/dev-db.sh provision.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=backtemplate;Username=backtemplate_app;Password=backtemplate_app_dev

# Las MIGRACIONES van con el rol DUENO del esquema (DDL). La usa el factory de diseno de EF
# (dotnet ef ...) y scripts/dev-db.sh migrate. La API NO la lee.
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=backtemplate;Username=backtemplate_owner;Password=backtemplate_owner_dev

# --- JWT (obligatorio) -------------------------------------------------------
# Jwt__Key: al menos 32 bytes, aleatoria. La API no arranca sin ella, con una corta o con un
# placeholder de ejemplo.
Jwt__Key=
Jwt__Issuer=back-template
Jwt__Audience=back-template-clients
# Access token corto: la revocacion de una sesion es efectiva, como tarde, cuando vence.
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Vida de los enlaces por correo.
Auth__InvitationHours=72
Auth__PasswordResetMinutes=60

# --- 2FA (TOTP) --------------------------------------------------------------
# Totp__EncryptionKey cifra los secretos TOTP guardados (AES-GCM). OBLIGATORIA, al menos 32 bytes
# y DISTINTA de Jwt__Key: rotar la del JWT no debe dejar ilegibles todos los secretos 2FA.
Totp__EncryptionKey=
# Etiqueta que muestra la app autenticadora.
Totp__Issuer=back-template

# --- Bootstrap del primer administrador --------------------------------------
# Habilita POST /api/v1/bootstrap/tenant (cabecera X-Bootstrap-Secret): crea un tenant y su
# primer administrador sin sesion. Vacio = bootstrap APAGADO (403), que es el estado correcto de
# un entorno ya aprovisionado. Si lo defines: al menos 32 bytes.
Bootstrap__Secret=

# --- Cliente web -------------------------------------------------------------
# Base de los enlaces que salen por correo (invitacion, restablecer contrasena). En produccion es
# obligatoria y https: con el default, los correos saldrian con enlaces a localhost.
Web__BaseUrl=http://localhost:5173
# Origenes CORS separados por comas (o arreglo en appsettings). Sin comodines. https en produccion.
Cors__AllowedOrigins=http://localhost:5173

# --- Correo (Mailpit del devstack) -------------------------------------------
# Con Smtp__Host el envio es real. Mailpit recoge todo sin entregarlo: bandeja en http://localhost:8025
# Sin Smtp__Host, en Development el correo va al log (con el enlace) y fuera de Development FALLA.
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__From=no-reply@back-template.local
Smtp__User=
Smtp__Password=

# --- Almacenamiento de objetos (MinIO del devstack) --------------------------
# Bucket PRIVADO; las lecturas salen con URLs prefirmadas de vida corta. En desarrollo la API crea el
# bucket si falta (con las credenciales de administracion del devstack). En produccion son OBLIGATORIAS
# y deben ser las de un usuario acotado a este bucket, no las de administracion.
ObjectStorage__Endpoint=localhost:9000
# Host con el que se FIRMAN las URLs (la firma incluye el host). Vacio = el mismo Endpoint.
# Con la API en contenedor: Endpoint=minio:9000 y PublicEndpoint=localhost:9000.
ObjectStorage__PublicEndpoint=
ObjectStorage__AccessKey=minioadmin
ObjectStorage__SecretKey=minioadmin
ObjectStorage__Bucket=backtemplate
ObjectStorage__UseSsl=false
ObjectStorage__CreateBucketIfMissing=true

# --- Detras de un proxy (produccion) -----------------------------------------
# Solo si hay un reverse proxy delante (Caddy en docker-compose.prod.yml). Encenderlo sin declarar
# la IP o la red del proxy no arranca: seria confiar en un X-Forwarded-For inventado.
ForwardedHeaders__Enabled=false
ForwardedHeaders__KnownProxies=
ForwardedHeaders__KnownNetworks=

# --- Limite de tasa (por minuto) ---------------------------------------------
RateLimiting__AuthPerMinute=10
RateLimiting__UploadPerMinute=30
RateLimiting__GlobalPerMinute=300

# --- Observabilidad ----------------------------------------------------------
# Seq del devstack (http://localhost:5341). Vacio = sin Seq.
Seq__ServerUrl=http://localhost:5341
# Nivel minimo (Verbose, Debug, Information, Warning, Error). Microsoft.AspNetCore queda en Warning:
# su logger de hosting escribe la URL completa, query string incluido.
Serilog__MinimumLevel__Default=Information
# Trazas y metricas por OTLP. Vacio = no se exportan.
Observability__OtlpEndpoint=

# --- Swagger ------------------------------------------------------------------
# En Development siempre esta; en otro entorno solo con esto en true.
Swagger__Enabled=false
